#!/bin/bash
#PBS -N hdems_seg
#PBS -P mi23
#PBS -q gpuvolta
#PBS -l ncpus=24
#PBS -l mem=128GB
#PBS -l ngpus=2
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/jq77+scratch/jq77+scratch/mi23
#PBS -l wd
#PBS -j oe
# ^ -l wd  : start in the directory you ran qsub from
#   -j oe  : merge stdout+stderr into one log (lands as hdems_seg.o<jobid> in that dir)

set -eo pipefail   # stop immediately if fit fails, so eval never runs on a stale/missing checkpoint

# ---------------------------------------------------------------------------
# PARAMETERS  (edit these; everything below is derived from them)
# ---------------------------------------------------------------------------
EV_FEATURE=phi         # phi | f                (event HV: Phi neighbourhood field, or descriptor F0)
AX_COMBINE=bind        # bind | bundle          (combine Vx,Vy)
EV_COMBINE=concat      # bind | bundle | bindbundle | concat   (combine event HV X with velocity Mv)
                       #   bindbundle = (X^ o Mv) + Mv
HEAD=cnn               # cnn | prototype | ridge | motion
LABEL_MODE=motion      # motion = moving vs background (Option A)
                       # objects = per-object id        (Option B)
DETECT=yes             # yes | no  -> also report object detection (boxes from instances)
SAMPLES=300            # max train frames   (train split has 9,446 usable)
VAL_SAMPLES=150        # val frames used to pick the best epoch / alpha
TEST_SAMPLES=50        # max eval panels saved

CODE_DIR=/scratch/mi23/nuwan/Event_segmentation_2/Train_based
CONFIG=configs/evimo_seg.yaml
VENV=/scratch/jq77/nk8155/seg/bin/activate

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
module load cuda
module load python3/3.9.2
source "${VENV}"
cd "${CODE_DIR}"

# Derived names -------------------------------------------------------------
RUN_NAME="${HEAD}_${EV_FEATURE}_${AX_COMBINE}_${EV_COMBINE}_${LABEL_MODE}_${SAMPLES}"
CKPT="checkpoints/${RUN_NAME}.pt"
RESULTS_DIR="results/${RUN_NAME}_$(date +%Y%m%d_%H%M%S)"
mkdir -p "${RESULTS_DIR}"

# ---------------------------------------------------------------------------
# RUN CONFIGURATION  (printed first, so every log explains its own results)
# Also saved to ${RESULTS_DIR}/run_config.txt next to the eval images.
# ---------------------------------------------------------------------------
{
echo "==============================================================="
echo " RUN CONFIGURATION"
echo "==============================================================="
echo " Job        : ${PBS_JOBID:-local}"
echo " Started    : $(date '+%Y-%m-%d %H:%M:%S')"
echo " Host       : $(hostname)"
echo " Run name   : ${RUN_NAME}"
echo " Checkpoint : ${CODE_DIR}/${CKPT}"
echo " Results    : ${CODE_DIR}/${RESULTS_DIR}"
echo
echo "--- run parameters (this script) ------------------------------"
printf '  %-16s %s\n' \
  HEAD         "${HEAD}" \
  EV_FEATURE   "${EV_FEATURE}" \
  AX_COMBINE   "${AX_COMBINE}" \
  EV_COMBINE   "${EV_COMBINE}" \
  LABEL_MODE   "${LABEL_MODE}" \
  DETECT       "${DETECT}" \
  SAMPLES      "${SAMPLES}  (train frames)" \
  VAL_SAMPLES  "${VAL_SAMPLES}  (val frames)" \
  TEST_SAMPLES "${TEST_SAMPLES}  (eval panels)" \
  CONFIG       "${CONFIG}"
echo
echo "--- PBS resources ---------------------------------------------"
qstat -f "${PBS_JOBID}" 2>/dev/null | grep -E 'Resource_List\.(ncpus|ngpus|mem|walltime|jobfs)|queue =' \
  | sed 's/^ */  /' || echo "  (qstat unavailable)"
echo
echo "--- hardware / software ---------------------------------------"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader 2>/dev/null \
  | sed 's/^/  GPU /' || echo "  (nvidia-smi unavailable)"
python -c "import sys, torch; print(f'  python {sys.version.split()[0]} | torch {torch.__version__} | cuda {torch.version.cuda} | gpus visible {torch.cuda.device_count()}')" 2>/dev/null \
  || echo "  (torch not importable)"
if git -C "${CODE_DIR}" rev-parse --short HEAD >/dev/null 2>&1; then
  echo "  git $(git -C "${CODE_DIR}" rev-parse --abbrev-ref HEAD)@$(git -C "${CODE_DIR}" rev-parse --short HEAD)" \
       "$(git -C "${CODE_DIR}" diff --quiet 2>/dev/null || echo '(uncommitted changes)')"
fi
echo
echo "--- config file: ${CONFIG}  (* = overridden by this script) ----"
python - "${CONFIG}" "${HEAD}" "${AX_COMBINE}" "${EV_COMBINE}" "${LABEL_MODE}" "${EV_FEATURE}" <<'PY' 2>/dev/null || echo "  (could not parse ${CONFIG})"
import sys, yaml
path, head, ax, ev, lm, feat = sys.argv[1:7]
cfg = yaml.safe_load(open(path)) or {}
# CLI flags passed by this script win over the YAML -- show the value actually used
override = {"segmentation.head": head, "velocity.axis_combine": ax,
            "velocity.event_combine": ev, "dataset.label_mode": lm,
            "velocity.event_feature": feat}
def walk(node, prefix=""):
    for k, v in node.items():
        key = f"{prefix}{k}"
        if isinstance(v, dict):
            walk(v, key + ".")
        elif key in override and str(v) != override[key]:
            print(f"  * {key:<34} = {override[key]}   (yaml: {v})")
        else:
            print(f"    {key:<34} = {v}")
walk(cfg)
PY
echo "==============================================================="
} 2>&1 | tee "${RESULTS_DIR}/run_config.txt"
cp "${CONFIG}" "${RESULTS_DIR}/" 2>/dev/null || true
SECONDS=0

# ---------------------------------------------------------------------------
# 1. FIT THE HEAD
# ---------------------------------------------------------------------------
echo ">>> [$(date +%T)] fitting ${HEAD} head (label_mode=${LABEL_MODE})"
python scripts/fit_ridge_head.py --config "${CONFIG}" \
  --head "${HEAD}" --event-feature "${EV_FEATURE}" \
  --axis-combine "${AX_COMBINE}" --event-combine "${EV_COMBINE}" \
  --label-mode "${LABEL_MODE}" --out "${CKPT}" \
  --device cuda --max-train-samples "${SAMPLES}" --max-val-samples "${VAL_SAMPLES}"

# ---------------------------------------------------------------------------
# 2. EVALUATE
# ---------------------------------------------------------------------------
# --detect adds box-level detection metrics (instances -> boxes) on top of segmentation
DETECT_FLAG=""
if [ "${DETECT}" = "yes" ]; then DETECT_FLAG="--detect"; fi

echo ">>> [$(date +%T)] evaluating -> ${RESULTS_DIR}/eval_images"
python -m hdems.eval --config "${CONFIG}" --head "${HEAD}" \
  --checkpoint "${CKPT}" ${DETECT_FLAG} \
  --device cuda --save-images "${RESULTS_DIR}/eval_images" \
  --color-events "${RESULTS_DIR}/event_colours" \
  --max-images "${TEST_SAMPLES}"

# CONTROL: predict "moving" at every event pixel. With motion labels this must
# score far below the model — if it does not, the labels are not motion.
echo ">>> [$(date +%T)] events-only baseline (control)"
python -m hdems.eval --config "${CONFIG}" --head "${HEAD}" \
  --checkpoint "${CKPT}" --events-only-baseline --device cuda

# ---------------------------------------------------------------------------
# 3. COLLECT  (keep a copy of the checkpoint + this log next to the results)
# ---------------------------------------------------------------------------
cp "${CKPT}" "${RESULTS_DIR}/" 2>/dev/null || true
echo "=== Job ${PBS_JOBID} (${RUN_NAME}) finished $(date)  --  elapsed $((SECONDS/3600))h $((SECONDS%3600/60))m ==="
# When this line completes, PBS tears the job down and stops billing. No qdel needed.


#qsub run_segmentation.pbs        # submit; prints a job id like 12345678.gadi-pbs
#qstat -u nk8155                  # check status: Q=queued, R=running, done=gone from list
#tail -f hdems_seg.o12345678      # watch the log live while it runs
#qdel 12345678                    # ONLY if you want to cancel early